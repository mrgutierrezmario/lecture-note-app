# Anthropic (Claude vision) — fill in to use Claude instead of llava for images
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lecture_notes

# Whisper Configuration
WHISPER_MODEL=small

# Notes Generation
NOTES_INTERVAL_SECONDS=60
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# MinIO/S3 Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lecture-audio
S3_REGION=us-east-1
S3_SECURE=false

# Storage Cleanup
AUDIO_RETENTION_DAYS=14
CLEANUP_INTERVAL_HOURS=24


# Signs login cookies; keep private. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
