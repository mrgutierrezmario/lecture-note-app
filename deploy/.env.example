# Copy to deploy/.env — start.sh does this and fills in the secrets on first run.

# Signs login cookies. Changing it signs everyone out.
SECRET_KEY=

# Internal service credentials (only reachable inside the stack).
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Public URL: https://<TS_HOSTNAME>.<your tailnet>.ts.net
TS_HOSTNAME=lecture-notes
# Optional: a Tailscale auth key (admin console > Settings > Keys) lets the stack
# join without the interactive login link. Leave blank to use the link.
TS_AUTHKEY=

# Local port for http://localhost:<APP_PORT> access on the Mac / LAN.
APP_PORT=8010

# Notes/vision model server. Leave OLLAMA_BASE_URL blank to run the bundled
# Ollama in Docker (CPU only). For GPU speed on a Mac, install Ollama natively
# (brew install ollama; brew services start ollama) and set:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=
# Bundled Ollama only: reuse models another Ollama already downloaded by
# pointing OLLAMA_MODELS at that directory on the Mac (absolute path).
OLLAMA_MODELS=
OLLAMA_MODEL=llama3
WHISPER_MODEL=small

# Claude vision for slides/images: paste the key in Settings > Claude credentials.
# (It is kept in the app-state volume; do not put it here — an empty value would
# shadow the saved key.)

AUDIO_RETENTION_DAYS=14

# Password-reset emails (optional). Gmail address + App Password from
# myaccount.google.com/apppasswords. Blank = "Forgot password?" is hidden.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=AI Lecture Notes
# Optional: address replies go to (Gmail always shows the account itself as From).
MAIL_REPLY_TO=
# Base URL used in emailed links (your Funnel URL).
PUBLIC_URL=
